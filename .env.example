# .env.example — Template environment variables for OmniDoc Studio
# Do not store real production secrets in this file.

# Application Environment (development | staging | production)
ENVIRONMENT=production

# Application Secret Key (Must be at least 32 random characters with high entropy)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-secure-random-32-character-secret-key-placeholder

# Database Configuration (Supabase PostgreSQL via connection pooler)
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:your_secure_password@aws-1-your-region.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Storage Provider Configuration (supabase | local | s3)
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
SUPABASE_BUCKET_NAME=documents

# Frontend URL (For CORS and redirect handling)
FRONTEND_URL=https://omnidoc-studio-jet.vercel.app
CORS_ORIGINS=https://omnidoc-studio-jet.vercel.app,http://localhost:5173

# Optional S3/R2 Configuration (Only if STORAGE_PROVIDER=s3)
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=

# Email Service Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@omnidoc.studio
EMAILS_FROM_NAME=OmniDoc Studio Security

# Payment Gateway (Completely disabled by default for zero-cost operation)
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis Cache / Rate Limiting (Optional in production; falls back to in-memory sliding window)
REDIS_URL=
REQUIRE_REDIS_RATE_LIMIT=false
