# .env.example for OmniDoc Studio
# Core settings
ENVIRONMENT=development
SECRET_KEY=your-secure-secret-key

# Database (PostgreSQL on Supabase)
DATABASE_URL=postgresql+asyncpg://username:password@YOUR_SUPABASE_PROJECT.supabase.co:5432/yourdb

# Storage configuration (Supabase)
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_NAME=documents

# Optional S3 configuration (if you ever switch back)
# STORAGE_PROVIDER=s3
# S3_BUCKET_NAME=your-bucket
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=

# Frontend URL (used for redirects in billing)
FRONTEND_URL=https://omnidoc-studio-jet.vercel.app

# Email settings (if needed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@omnidoc.studio
EMAILS_FROM_NAME=OmniDoc Studio Security

# Stripe (optional, can be disabled)
ENABLE_STRIPE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

